<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
    version="3.0">
    <persistence-unit name="WypozyczalniaAut" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>library.objects.Klient</class>
        <class>library.objects.auto.Auto</class>
        <class>library.objects.auto.SamochodOsobowy</class>
        <class>library.objects.auto.SamochodCiezarowy</class>
        <class>library.objects.Wypozyczenie</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5444/nbddb" />
            <property name="jakarta.persistence.jdbc.user" value="nbd" />
            <property name="jakarta.persistence.jdbc.password" value="nbdpassword" />

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="false" />
            <property name="hibernate.format_sql" value="true" />
            <property name="jakarta.persistence.schema-generation.database.action"
                value="drop-and-create" />
            <property name="hibernate.connection.isolation" value="2" />
        </properties>
    </persistence-unit>
</persistence>